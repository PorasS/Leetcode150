class Solution {
    public int[] maxSlidingWindow(int[] nums, int k) {


        if(k == 1){
            return nums;
        } 
    
        List<Integer> res = new ArrayList<>();

        PriorityQueue<Integer> maxHeap = new PriorityQueue<>(k, (a,b) -> Integer.compare(b,a));

        int r = k;
        int l = 0;

        for(int i = 0; i < r; i++){
            maxHeap.offer(nums[i]);
        }

        res.add(maxHeap.peek());

        while(r < nums.length){
            maxHeap.remove(nums[l++]);
            maxHeap.offer(nums[r++]);
            res.add(maxHeap.peek());
        }

        int[] resArr = res.stream().mapToInt(Integer::intValue).toArray();

        return resArr;


